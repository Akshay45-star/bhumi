# ─── Copy this to .env and fill in your values ──────────────────────────────

# Security — generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
HMAC_SECRET=your_hmac_secret_here

# App URL — your public domain or Railway URL
APP_URL=https://your-backend.railway.app

# Cloudflare R2 — get from cloudflare.com/r2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=bhumi-videos
R2_PUBLIC_URL=https://bhumi-videos.your-account-id.r2.cloudflarestorage.com

# SendGrid — get from sendgrid.com
SENDGRID_API_KEY=SG.your_key_here
SENDGRID_FROM_EMAIL=support@bhumi.app
SENDGRID_FROM_NAME=Bhumi

# Expo push notifications — get from expo.dev
EXPO_ACCESS_TOKEN=your_expo_token

# OpenAI — optional, only needed for Life Summary feature
OPENAI_API_KEY=sk-your_key_here
